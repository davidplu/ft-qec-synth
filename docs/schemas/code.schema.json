{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "generators"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[IXYZ]+$"
      }
    }
  },
  "additionalProperties": false
}
