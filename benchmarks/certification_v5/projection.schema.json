{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logical coordinate physical projection certificate",
  "type": "object",
  "required": ["algorithm", "lower_bound", "circuit_hash", "fault_inventory_hash", "coordinate_masks", "detector_combinations", "coordinate_count", "maximum_single_fault_coordinate_weight", "scope"],
  "properties": {
    "algorithm": {"const": "logical-packing-physical-projection-1"},
    "lower_bound": {"type": "integer", "minimum": 1},
    "circuit_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fault_inventory_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coordinate_masks": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "detector_combinations": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "coordinate_count": {"type": "integer", "minimum": 1},
    "maximum_single_fault_coordinate_weight": {"type": "integer", "minimum": 1},
    "scope": {"type": "string"}
  }
}
